{
  "name": "ckm-truth-or-dare",
  "version": "1.0.0",
  "description": "Serverless Truth or Dare Discord bot for Cloudflare Workers + D1 with server-wide leaderboard.",
  "main": "src/worker.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "db:init:local": "wrangler d1 execute truth-or-dare-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute truth-or-dare-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "truth-or-dare",
    "cloudflare-workers",
    "d1"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "discord-interactions": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^24.0.0",
    "dotenv": "^17.2.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.159.0"
  }
}
